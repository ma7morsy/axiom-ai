{
  "expo": {
    "name": "Axiom AI",
    "slug": "axiom-ai",
    "scheme": "axiom",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "infoPlist": { "NSMicrophoneUsageDescription": "Used for voice input and voice cloning." } },
    "android": { "permissions": ["RECORD_AUDIO"] },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
